# Leave DATABASE_URL unset for local development: an embedded PGlite database
# is created under ./.data automatically.
#
# Production: Coolify sets DATABASE_URL on the app to the internal address of the
# Postgres container on the same server. It looks like:
# DATABASE_URL=postgres://user:password@<container-name>:5432/lahga

# Canonical origin of the site (defaults to https://lahga.fyi in nuxt.config.ts).
# NUXT_PUBLIC_SITE_URL=https://lahga.fyi

# ---- Accounts (phase 1) ----
# Seals the session cookie. At least 32 random characters. In development it is
# generated and written to .env automatically.
# NUXT_SESSION_PASSWORD=

# Google login: create an OAuth client at https://console.cloud.google.com/apis/credentials
# with the redirect URI https://lahga.fyi/auth/google (and http://localhost:3000/auth/google for dev).
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# NUXT_PUBLIC_GOOGLE_LOGIN=1

# Transactional email through Brevo (https://app.brevo.com). Without the key,
# emails are printed to the server log instead of being sent.
# BREVO_API_KEY=
# EMAIL_FROM=لهجة <no-reply@lahga.fyi>

# Cloudflare Turnstile on the registration form (https://dash.cloudflare.com → Turnstile).
# Without the keys the widget and the check are skipped.
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# NUXT_TURNSTILE_SECRET_KEY=

# Where the contact form's messages go. Without it the form says it is not enabled.
# CONTACT_EMAIL=you@example.com

# Local development only (embedded database): an admin account is created on
# start so you can log in without a verification email. Defaults shown.
# DEV_ADMIN_EMAIL=admin@lahga.test
# DEV_ADMIN_PASSWORD=lahga1234
# DEV_ADMIN_NAME=المدير المحلي

# Lets a script call POST /api/admin/import with "Authorization: Bearer <token>"
# instead of an admin session. At least 32 random characters. Optional.
# IMPORT_TOKEN=

# ---- Analytics (docs/REACH.md, Phase R1) ----
# Self-hosted Umami. Without a website id the <script> tag is not emitted at
# all — no analytics call happens, cookie-free either way. The website id is
# not a secret (it is visible in every page's source) but lives here so a dev
# checkout never phones home to the production Umami instance by accident.
# NUXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only needed if Umami is not at the default https://analytics.lahga.fyi/script.js
# NUXT_PUBLIC_UMAMI_SCRIPT_URL=
